# Configuracion para docker compose.
# Opcion rapida: ejecuta scripts/configurar (crea .env con una clave aleatoria).
# Opcion manual: copia este archivo como ".env" y cambia POSTGRES_PASSWORD.
# El archivo .env NO se sube a GitHub.
#
# IMPORTANTE: Postgres usa estos valores solo la PRIMERA vez que crea su volumen de datos.
# Si la base ya existe, la clave de aqui debe ser la que ya tiene (ver README).
# Usa solo letras y numeros en la clave (va dentro de una URL de conexion).

POSTGRES_USER=minutas
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=minutas

# Puertos en tu PC. Cambialos si ya estan ocupados (por ejemplo, si tienes otro Postgres instalado).
POSTGRES_PORT=5432
FRONTEND_PORT=8080
