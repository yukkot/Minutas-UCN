# Configuracion del backend para el modo desarrollo (npm run dev).
# scripts/configurar lo crea automaticamente con los mismos datos del .env de la raiz.
PORT=3000
# Usuario, clave, puerto y base deben coincidir con el .env de la raiz del proyecto
DATABASE_URL=postgres://minutas:cambia_esta_clave@localhost:5432/minutas
CORS_ORIGIN=http://localhost:5173
MAX_UPLOAD_MB=10

# Procesamiento asincrono de importaciones
# true = la API tambien procesa los Excel (asi en desarrollo basta con "npm run dev").
EJECUTAR_WORKER=true
WORKER_INTERVALO_MS=1000
WORKER_MAX_INTENTOS=3
WORKER_TIMEOUT_MIN=5
WORKER_TAMANO_LOTE=500
